{
  "manifest_version": 3,
  "name": "LinkReady",
  "version": "0.1.0",
  "description": "Copy the current page link in the format you need.",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Copy clean link"
  }
}
